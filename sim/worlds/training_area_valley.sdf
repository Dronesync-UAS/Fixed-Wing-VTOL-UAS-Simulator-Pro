<?xml version="1.0" ?>
<!-- ================================================================
     VALLEY TRAINING AREA - north Wales foothills. Added 12 Oct 2026.

     WHY THIS WORLD EXISTS. Every other area in this set is open ground
     with a clear horizon. This one puts the aircraft on a flat floor
     with 200 m of hillside on both sides, which changes three things a
     student has to learn:

       * the horizon is no longer the horizon. Judging attitude against
         a ridge line 200 m above you is a different skill, and getting
         it wrong is how people fly into rising ground;
       * line of sight goes. The aircraft disappears behind a spur long
         before it reaches the range limit, which is the real reason
         visual line of sight operations fail;
       * the gimbal has to look UP as well as down, which none of the
         other areas ever requires.

     THE TERRAIN IS SYNTHETIC. The coordinates and the magnetic field
     are real - PX4's EKF needs a field that matches the latitude it is
     told it is at - but the shape of the ground is generated by
     tools/make_valley_heightmap.py and is not a survey of anywhere.
     Do not describe it to a student as a real valley.

     THE FLOOR IS FLAT where it matters. Dead level out to 520 m either
     side of the valley axis, which contains the station's whole 500 m
     operating area. A world with relief inside the range limit has no
     airspace a student can legally fly in - the same reasoning that had
     tools/widen_clearing.py flatten 600 m of the Hoggar world.

     NOT YET RUN. This world has not been loaded in Gazebo, and no
     aircraft has been flown in it.
     ================================================================ -->
<sdf version="1.9">
  <world name="training_area_valley">

    <physics name="1ms" type="ignore">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- IGRF field at this world's own coordinates (52.9000N, -3.8000E,
         220 m) for 2026-10-12, in tesla ENU per the SDF spec:
         49398 nT, declination -0.19 deg, inclination +67.51 deg. Computed with ppigrf, the
         same way tools/fix_magnetic_field.py does the older worlds -
         NOT sdformat's placeholder, which would be several degrees out
         in inclination here and would keep PX4's EKF from settling on
         a heading. -->
    <magnetic_field>-6.333e-08 1.89e-05 -4.564e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>52.9</latitude_deg>
      <longitude_deg>-3.8</longitude_deg>
      <elevation>220</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 0.97 0.90 1</diffuse>
      <specular>0.35 0.35 0.33 1</specular>
      <direction>-0.55 0.35 -0.62</direction>
    </light>

    <scene>
      <ambient>0.40 0.41 0.44 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
      <!-- A real skybox instead of one flat colour. gz-rendering8
           applies it to every sensor camera too, so the chase and
           nose feeds get it, not only the Gazebo window. Its
           sdformat sub-elements (time, clouds, humidity) are
           ignored by this renderer - it is on or off. -->
      <sky></sky>
    </scene>

    <!-- Flat ground with its top surface at Z=0.

         The collision is a very large BOX sunk 5 m, not a plane. PX4's own
         working default.sdf does exactly this (box 100000 x 100000 x 10 at
         pose 0 0 -5), and training_area's safety floor is a box too. A
         <plane> collision was tried here first and the aircraft fell straight
         through it - it appeared in the entity tree and in the model list
         reported by gz, but was nowhere to be seen, because it was still
         falling. Follow the
         working reference rather than the tidier-looking geometry.

         The visual stays a plane: 8 km square, large enough that the horizon
         is never a visible boundary at training altitudes. -->
    <!-- THE VALLEY. A heightmap rather than a plane, which is the whole
         point of this area: the aircraft flies along a flat floor with
         ground 200 m above it on both sides.

         The floor is dead flat out to 520 m either side of the axis,
         which contains the station's whole 500 m operating area, so
         there is no relief anywhere a student can legally fly. The
         ridges rise beyond that and reach full height by about 1400 m
         out. tools/make_valley_heightmap.py generates the image and
         explains the shape; it is SYNTHETIC, not a survey of anywhere.

         <size> is width, depth and the height of pixel 255: 8 km square
         and 240 m of relief, so one grey level is 0.94 m and the floor
         sits at exactly z = 0.

         The friction/bounce/contact <surface> block is the one from the
         fix that resolved the Hoggar terrain's resting-drift bug on
         23 Aug 2026, included here from the start. NOT yet verified
         against vehicle_local_position_groundtruth for a genuine
         zero-drift rest - do that before relying on this for training. -->
    <model name="valley_terrain">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>file://media/valley_heightmap.png</uri>
              <size>8000 8000 240</size>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <uri>file://media/valley_heightmap.png</uri>
              <size>8000 8000 240</size>
              <texture>
                <diffuse>file://media/grass_diffuse.png</diffuse>
                <normal>file://media/ground_normal.png</normal>
                <size>24</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- A grid of markers every 100 m, so drift and distance are visible by
         eye rather than only on the instruments. Collision-free. -->
    <model name="distance_markers">
      <static>true</static>
      <link name="markers_link">
        <visual name="marker_n100"><pose>100 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_n200"><pose>200 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_e100"><pose>0 100 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
        <visual name="marker_e200"><pose>0 200 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Wind: speed/direction are set at runtime by the instructor station over
         /world/NAME/wind (gz.msgs.Wind). Zero here so an untouched sim
         flies exactly as it did before wind was added. -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.03</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.03</stddev>
        </noise>
      </vertical>
    </plugin>
    <!-- Weather cell. Switched on at runtime by the instructor station over
         /weather/fog and /weather/rain (gz.msgs.ParticleEmitter);
         both start off, so an untouched sim looks exactly as it did before.
         Rendering only - this does not change how the aircraft flies.
         Added by tools/weather_apply.py. -->
    <plugin filename="gz-sim-particle-emitter-system"
            name="gz::sim::systems::ParticleEmitter">
    </plugin>
    <model name="weather_cell">
      <static>true</static>
      <!-- At this world's own ground height; emitter heights below are
           relative to it, so the cell sits over the ground in every world. -->
      <pose>0 0 0.3 0 0 0</pose>
      <link name="weather_link">
        <particle_emitter name="fog" type="box">
          <topic>/weather/fog</topic>
          <emitting>false</emitting>
          <!-- Tighter than the first attempt (was 240 x 240): the same
               particle budget spread over a quarter of the area is four times
               the obscuration. -->
          <pose>0 0 45 0 0 0</pose>
          <size>120 120 30</size>
          <!-- X and Y only; Z is ignored (see the rain emitter below). -->
          <particle_size>18 18 0</particle_size>
          <lifetime>25</lifetime>
          <min_velocity>0.1</min_velocity>
          <max_velocity>0.5</max_velocity>
          <scale_rate>0.5</scale_rate>
          <rate>160</rate>
          <particle_scatter_ratio>0.9</particle_scatter_ratio>
          <!-- The texture is what makes a particle a shape rather than a
               square. Without an albedo map Ogre draws a flat, hard-edged
               quad, which is what the first fog test looked like: pale
               rectangles stacked in the sky. -->
          <material>
            <diffuse>0.85 0.87 0.90</diffuse>
            <specular>0.85 0.87 0.90</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/particle_soft.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </particle_emitter>
        <!-- Pitched 90 degrees about Y so the emitter's local +X, which is the
             only direction Ogre2ParticleEmitter ever emits along, points at
             world -Z. Without this, rain falls sideways. -->
        <particle_emitter name="rain" type="box">
          <topic>/weather/rain</topic>
          <emitting>false</emitting>
          <!-- 45 m, not 95: the fall time sets the lifetime, the lifetime sets
               the rate ceiling (quota/lifetime), and the rate sets how much
               rain you can actually see. Halving the drop roughly trebles the
               rain. 45 m at 12-16 m/s is ~3.2 s, inside the 4 s lifetime. -->
          <pose>0 0 45 0 1.5707963 0</pose>
          <size>70 70 0</size>
          <!-- Only X and Y are read - Ogre2ParticleEmitter passes them to
               setDefaultDimensions(width, height) and ignores Z. 0.12 x 2.0 is
               a falling streak; the first attempt put the length in Z and so
               rendered 8 cm squares, which is why heavy rain looked like
               almost nothing. -->
          <particle_size>0.12 2.0 0</particle_size>
          <lifetime>4</lifetime>
          <min_velocity>12</min_velocity>
          <max_velocity>16</max_velocity>
          <scale_rate>0</scale_rate>
          <rate>450</rate>
          <particle_scatter_ratio>0.4</particle_scatter_ratio>
          <material>
            <diffuse>0.60 0.68 0.78</diffuse>
            <specular>0.60 0.68 0.78</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/particle_streak.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </particle_emitter>
      </link>
    </model>
      <!-- SCENERY: added by tools/scenery_apply.py.
         122 features, laid out deterministically from the world's
         own name - see scenery.py for what is here and why. The
         first 90 m around the launch point is left clear. Payload
         targets 1-3 are at 1: 035 deg / 260 m, 2: 160 deg / 430 m, 3: 285 deg / 700 m. -->
    <model name="scenery_0">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>2600 5 0.06</size></box></geometry><material><ambient>0.0935 0.0935 0.099 1</ambient><diffuse>0.17 0.17 0.18 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_1">
      <static>true</static>
      <pose>-660 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_2">
      <static>true</static>
      <pose>-550 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_3">
      <static>true</static>
      <pose>-440 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_4">
      <static>true</static>
      <pose>-330 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_5">
      <static>true</static>
      <pose>-220 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_6">
      <static>true</static>
      <pose>-110 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_7">
      <static>true</static>
      <pose>110 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_8">
      <static>true</static>
      <pose>220 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_9">
      <static>true</static>
      <pose>330 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_10">
      <static>true</static>
      <pose>440 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_11">
      <static>true</static>
      <pose>550 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_12">
      <static>true</static>
      <pose>660 0 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>520 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_13">
      <static>true</static>
      <pose>-340 160 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 2.1 0 0 0</pose><geometry><box><size>12 8 4.2</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><collision name="p0_c"><pose>0 0 2.1 0 0 0</pose><geometry><box><size>12 8 4.2</size></box></geometry><surface><friction><ode/></friction><bounce/><contact/></surface></collision><visual name="p1"><pose>-3 0 5.41208 0 0 0</pose><geometry><box><size>6.47121 8 0.12</size></box></geometry><material><ambient>0.154 0.1595 0.165 1</ambient><diffuse>0.28 0.29 0.3 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p2"><pose>3 0 5.41208 0 0 0</pose><geometry><box><size>6.47121 8 0.12</size></box></geometry><material><ambient>0.154 0.1595 0.165 1</ambient><diffuse>0.28 0.29 0.3 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_14">
      <static>true</static>
      <pose>-318 178 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>16 7 3.6</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><collision name="p0_c"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>16 7 3.6</size></box></geometry><surface><friction><ode/></friction><bounce/><contact/></surface></collision><visual name="p1"><pose>-4 0 5.2161 0 0 0</pose><geometry><box><size>8.62828 7 0.12</size></box></geometry><material><ambient>0.154 0.1595 0.165 1</ambient><diffuse>0.28 0.29 0.3 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p2"><pose>4 0 5.2161 0 0 0</pose><geometry><box><size>8.62828 7 0.12</size></box></geometry><material><ambient>0.154 0.1595 0.165 1</ambient><diffuse>0.28 0.29 0.3 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_15">
      <static>true</static>
      <pose>-360 190 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>60 0.6 1.4</size></box></geometry><material><ambient>0.286 0.2805 0.2585 1</ambient><diffuse>0.52 0.51 0.47 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_16">
      <static>true</static>
      <pose>-330 130 0 0 0 0.7</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>5.2 2 1</size></box></geometry><material><ambient>0.1375 0.231 0.154 1</ambient><diffuse>0.25 0.42 0.28 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><collision name="p0_c"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>5.2 2 1</size></box></geometry><surface><friction><ode/></friction><bounce/><contact/></surface></collision><visual name="p1"><pose>-0.4 0 1.5 0 0 0</pose><geometry><box><size>2.4 1.9 0.9</size></box></geometry><material><ambient>0.11 0.121 0.1375 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p2"><pose>1.7 1 0.38 0 1.5708 0</pose><geometry><cylinder><radius>0.38</radius><length>0.25</length></cylinder></geometry><material><ambient>0.055 0.055 0.055 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p3"><pose>1.7 -1 0.38 0 1.5708 0</pose><geometry><cylinder><radius>0.38</radius><length>0.25</length></cylinder></geometry><material><ambient>0.055 0.055 0.055 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p4"><pose>-1.7 1 0.38 0 1.5708 0</pose><geometry><cylinder><radius>0.38</radius><length>0.25</length></cylinder></geometry><material><ambient>0.055 0.055 0.055 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p5"><pose>-1.7 -1 0.38 0 1.5708 0</pose><geometry><cylinder><radius>0.38</radius><length>0.25</length></cylinder></geometry><material><ambient>0.055 0.055 0.055 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_17">

<?xml version="1.0" ?>
<!-- ================================================================
     FLAT TEST WORLD - added 11 Oct 2026.

     A clear, genuinely flat environment for testing the aircraft at
     real ground level, with nothing to fly into and no terrain
     alignment to doubt.

     Why it exists: in training_area.sdf the aircraft spawns at world
     (0, 0, 615.5) while the terrain model is shifted by -779.7 m in X
     to bring its carved clearing to the origin. When that alignment is
     wrong the aircraft spawns inside a mountain, which makes every
     other test unreadable - you cannot tell a flight-control problem
     from a terrain problem. This world removes that variable.

     Deliberately identical to training_area.sdf in everything that
     affects how the aircraft flies:
       * same physics step and real-time factor
       * same gravity, magnetic field and atmosphere
       * same spherical coordinates, so QGroundControl's map and the
         simulated GPS position agree as they do in the training world
       * the same eleven world systems, in the same order
       * the same wind element and WindEffects plugin, so wind tests
         behave the same here
     The only difference is the ground: an infinite flat plane at Z=0
     with the <surface> block copied from Gazebo's own stock
     ground_plane, which the 23 Aug entry proved settles the aircraft
     to an exact zero resting speed.

     No media files needed - the ground is a plain material, not a
     textured heightmap - so this world can be dropped into any PX4
     checkout on its own.

     Spawn at Z=0.3, just clear of the ground:
       PX4_GZ_MODEL_POSE="0,0,0.3,0,0,0" PX4_GZ_WORLD=flat_test \
         make px4_sitl gz_standard_vtol
     and point the station at it with GCS_WORLD=flat_test.
     ================================================================ -->
<sdf version="1.9">
  <world name="flat_test">

    <physics name="1ms" type="ignore">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- IGRF field at this world's own coordinates (23.2667N, 5.6333E,
         1400 m) for 2026-10-11, in tesla ENU per the SDF spec. NOT
         sdformat's default placeholder, which is ~48 uT at 60 deg
         inclination and would be 32 deg wrong here - enough to stop
         PX4's EKF converging on a heading once a magnetometer exists. -->
    <magnetic_field>9.01e-07 3.375e-05 -1.801e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>23.2667</latitude_deg>
      <longitude_deg>5.6333</longitude_deg>
      <elevation>1400</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Flat ground at Z=0. Collision is an infinite plane, so there is no
         edge to fly off; the visual is a 8km square, large enough that the
         horizon is never a visible boundary at training altitudes. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8000 8000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.33 0.40 0.26 1</ambient>
            <diffuse>0.40 0.48 0.31 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- A grid of markers every 100 m, so drift and distance are visible by
         eye rather than only on the instruments. Collision-free. -->
    <model name="distance_markers">
      <static>true</static>
      <link name="markers_link">
        <visual name="marker_n100"><pose>100 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_n200"><pose>200 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_e100"><pose>0 100 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
        <visual name="marker_e200"><pose>0 200 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Wind: speed/direction are set at runtime by the instructor station over
         /world/NAME/wind (gz.msgs.Wind). Zero here so an untouched sim
         flies exactly as it did before wind was added. -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.03</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.03</stddev>
        </noise>
      </vertical>
    </plugin>
  </world>
</sdf>

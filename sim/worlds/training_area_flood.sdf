<?xml version="1.0" ?>
<!-- ================================================================
     FLOODED FARMLAND - Somerset Levels. Added 12 Oct 2026.

     WHY THIS WORLD EXISTS. Flood response is the UAS job that actually
     pays in the UK, and it is nothing like the other areas. The ground
     and the water are almost the same colour and the edge between them
     is genuinely hard to see, which is the whole lesson: a pilot has to
     work out from hedge lines and roof lines where the fields were.

     The raised road is the only dry ground, so it is where every vehicle
     and every person will be - which is exactly the reasoning a real
     tasking uses.

     THE WATER IS A FLAT PLATE. It does not move, nothing floats on it,
     and its depth is not modelled. The brown-green colour is deliberate:
     flood water carries soil and does not look like the sea.

     WHERE IT IS. the Somerset Levels, 51.1000 N -2.8500 E,
     5 m above sea level. Flat, like every other area in this set, for
     the same reason: a PX4 VTOL behaves itself over level ground and
     the station enforces a 120 m ceiling, so relief inside the range
     limit would leave no airspace to fly in.

     The ground is a plane rather than a heightmap. Everything that
     makes this a place is scenery, added by tools/scenery_apply.py -
     see scenery.py for what is in it and why.

     NOT YET RUN. This world has not been loaded in Gazebo, and no
     aircraft has been flown in it.
     ================================================================ -->
<sdf version="1.9">
  <world name="training_area_flood">

    <physics name="1ms" type="ignore">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- IGRF field at this world's own coordinates (51.1000N, -2.8500E,
         5 m) for 2026-10-12, in tesla ENU per the SDF spec:
         48907 nT, declination +0.32 deg, inclination +66.07 deg. Computed with ppigrf, the
         same way tools/fix_magnetic_field.py does the older worlds -
         NOT sdformat's placeholder, which would be several degrees out
         in inclination here and would keep PX4's EKF from settling on
         a heading. -->
    <magnetic_field>1.11e-07 1.984e-05 -4.47e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.1</latitude_deg>
      <longitude_deg>-2.85</longitude_deg>
      <elevation>5</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 0.97 0.90 1</diffuse>
      <specular>0.35 0.35 0.33 1</specular>
      <direction>-0.55 0.35 -0.62</direction>
    </light>

    <scene>
      <ambient>0.40 0.41 0.44 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
      <!-- A real skybox instead of one flat colour. gz-rendering8
           applies it to every sensor camera too, so the chase and
           nose feeds get it, not only the Gazebo window. Its
           sdformat sub-elements (time, clouds, humidity) are
           ignored by this renderer - it is on or off. -->
      <sky></sky>
    </scene>

    <!-- Flat ground with its top surface at Z=0.

         The collision is a very large BOX sunk 5 m, not a plane. PX4's own
         working default.sdf does exactly this (box 100000 x 100000 x 10 at
         pose 0 0 -5), and training_area's safety floor is a box too. A
         <plane> collision was tried here first and the aircraft fell straight
         through it - it appeared in the entity tree and in the model list
         reported by gz, but was nowhere to be seen, because it was still
         falling. Follow the
         working reference rather than the tidier-looking geometry.

         The visual stays a plane - widened from 8 km to 220 km square
         on 12 Oct 2026 by tools/far_ground_apply.py, so the 100 km
         instructor envelope is not flown over a void. A plane carries
         flat colour rather than a tiled texture, so the width costs
         nothing to render. The collision box was widened to match:
         it used to stop 50 km from home, half the envelope. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <pose>0 0 -5 0 0 0</pose>
          <geometry>
            <box>
              <size>220000 220000 10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>220000 220000</size>
            </plane>
          </geometry>
          <material>
            <!-- Wet pasture. The standing water is laid over this by the scenery. -->
            <ambient>0.22 0.30 0.16 1</ambient>
            <diffuse>0.29 0.38 0.21 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- A grid of markers every 100 m, so drift and distance are visible by
         eye rather than only on the instruments. Collision-free. -->
    <model name="distance_markers">
      <static>true</static>
      <link name="markers_link">
        <visual name="marker_n100"><pose>100 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_n200"><pose>200 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_e100"><pose>0 100 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
        <visual name="marker_e200"><pose>0 200 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Wind: speed/direction are set at runtime by the instructor station over
         /world/NAME/wind (gz.msgs.Wind). Zero here so an untouched sim
         flies exactly as it did before wind was added. -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.03</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.03</stddev>
        </noise>
      </vertical>
    </plugin>
    <!-- Weather cell. Switched on at runtime by the instructor station over
         /weather/fog and /weather/rain (gz.msgs.ParticleEmitter);
         both start off, so an untouched sim looks exactly as it did before.
         Rendering only - this does not change how the aircraft flies.
         Added by tools/weather_apply.py. -->
    <plugin filename="gz-sim-particle-emitter-system"
            name="gz::sim::systems::ParticleEmitter">
    </plugin>
    <model name="weather_cell">
      <static>true</static>
      <!-- At this world's own ground height; emitter heights below are
           relative to it, so the cell sits over the ground in every world. -->
      <pose>0 0 0.3 0 0 0</pose>
      <link name="weather_link">
        <particle_emitter name="fog" type="box">
          <topic>/weather/fog</topic>
          <emitting>false</emitting>
          <!-- Tighter than the first attempt (was 240 x 240): the same
               particle budget spread over a quarter of the area is four times
               the obscuration. -->
          <pose>0 0 45 0 0 0</pose>
          <size>120 120 30</size>
          <!-- X and Y only; Z is ignored (see the rain emitter below). -->
          <particle_size>18 18 0</particle_size>
          <lifetime>25</lifetime>
          <min_velocity>0.1</min_velocity>
          <max_velocity>0.5</max_velocity>
          <scale_rate>0.5</scale_rate>
          <rate>160</rate>
          <particle_scatter_ratio>0.9</particle_scatter_ratio>
          <!-- The texture is what makes a particle a shape rather than a
               square. Without an albedo map Ogre draws a flat, hard-edged
               quad, which is what the first fog test looked like: pale
               rectangles stacked in the sky. -->
          <material>
            <diffuse>0.85 0.87 0.90</diffuse>
            <specular>0.85 0.87 0.90</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/particle_soft.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </particle_emitter>
        <!-- Pitched 90 degrees about Y so the emitter's local +X, which is the
             only direction Ogre2ParticleEmitter ever emits along, points at
             world -Z. Without this, rain falls sideways. -->
        <particle_emitter name="rain" type="box">
          <topic>/weather/rain</topic>
          <emitting>false</emitting>
          <!-- 45 m, not 95: the fall time sets the lifetime, the lifetime sets
               the rate ceiling (quota/lifetime), and the rate sets how much
               rain you can actually see. Halving the drop roughly trebles the
               rain. 45 m at 12-16 m/s is ~3.2 s, inside the 4 s lifetime. -->
          <pose>0 0 45 0 1.5707963 0</pose>
          <size>70 70 0</size>
          <!-- Only X and Y are read - Ogre2ParticleEmitter passes them to
               setDefaultDimensions(width, height) and ignores Z. 0.12 x 2.0 is
               a falling streak; the first attempt put the length in Z and so
               rendered 8 cm squares, which is why heavy rain looked like
               almost nothing. -->
          <particle_size>0.12 2.0 0</particle_size>
          <lifetime>4</lifetime>
          <min_velocity>12</min_velocity>
          <max_velocity>16</max_velocity>
          <scale_rate>0</scale_rate>
          <rate>450</rate>
          <particle_scatter_ratio>0.4</particle_scatter_ratio>
          <material>
            <diffuse>0.60 0.68 0.78</diffuse>
            <specular>0.60 0.68 0.78</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/particle_streak.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </particle_emitter>
      </link>
    </model>
      <!-- SCENERY: added by tools/scenery_apply.py.
         60 features, laid out deterministically from the world's
         own name - see scenery.py for what is here and why. The
         first 90 m around the launch point is left clear. Payload
         targets 1-3 are at 1: 035 deg / 260 m, 2: 160 deg / 430 m, 3: 285 deg / 700 m. -->
    <model name="scenery_0">
      <static>true</static>
      <pose>260 -180 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><ellipsoid><radii>340 340 0.85</radii></ellipsoid></geometry><material><ambient>0.143 0.1485 0.121 1</ambient><diffuse>0.26 0.27 0.22 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_1">
      <static>true</static>
      <pose>-180 300 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><ellipsoid><radii>280 280 0.7</radii></ellipsoid></geometry><material><ambient>0.143 0.1485 0.121 1</ambient><diffuse>0.26 0.27 0.22 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_2">
      <static>true</static>
      <pose>480 260 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><ellipsoid><radii>220 220 0.55</radii></ellipsoid></geometry><material><ambient>0.143 0.1485 0.121 1</ambient><diffuse>0.26 0.27 0.22 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_3">
      <static>true</static>
      <pose>-420 -260 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><ellipsoid><radii>300 300 0.75</radii></ellipsoid></geometry><material><ambient>0.143 0.1485 0.121 1</ambient><diffuse>0.26 0.27 0.22 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_4">
      <static>true</static>
      <pose>120 520 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><ellipsoid><radii>200 200 0.5</radii></ellipsoid></geometry><material><ambient>0.143 0.1485 0.121 1</ambient><diffuse>0.26 0.27 0.22 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_5">
      <static>true</static>
      <pose>-560 120 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><ellipsoid><radii>180 180 0.45</radii></ellipsoid></geometry><material><ambient>0.143 0.1485 0.121 1</ambient><diffuse>0.26 0.27 0.22 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_6">
      <static>true</static>
      <pose>-808.705 680.761 0 0 0 2.74771</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>123.521 1.8 2.2</size></box></geometry><material><ambient>0.088 0.143 0.0715 1</ambient><diffuse>0.16 0.26 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_7">
      <static>true</static>
      <pose>-86.7401 -818.113 0 0 0 0.890046</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>188.382 1.8 2.2</size></box></geometry><material><ambient>0.088 0.143 0.0715 1</ambient><diffuse>0.16 0.26 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_8">
      <static>true</static>
      <pose>-388.847 -607.833 0 0 0 1.55565</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>90.3405 1.8 2.2</size></box></geometry><material><ambient>0.088 0.143 0.0715 1</ambient><diffuse>0.16 0.26 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_9">
      <static>true</static>
      <pose>-883.226 -651.884 0 0 0 1.54214</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>167.954 1.8 2.2</size></box></geometry><material><ambient>0.088 0.143 0.0715 1</ambient><diffuse>0.16 0.26 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_10">
      <static>true</static>
      <pose>506.351 224.357 0 0 0 0.457891</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>173.524 1.8 2.2</size></box></geometry><material><ambient>0.088 0.143 0.0715 1</ambient><diffuse>0.16 0.26 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>

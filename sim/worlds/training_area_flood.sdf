      <static>true</static>
      <pose>300 -150 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 3 0 0 0</pose><geometry><box><size>12 22 6</size></box></geometry><material><ambient>0.3025 0.231 0.187 1</ambient><diffuse>0.55 0.42 0.34 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><collision name="p0_c"><pose>0 0 3 0 0 0</pose><geometry><box><size>12 22 6</size></box></geometry><surface><friction><ode/></friction><bounce/><contact/></surface></collision><visual name="p1"><pose>-3 0 7.21208 0 0 0</pose><geometry><box><size>6.47121 22 0.12</size></box></geometry><material><ambient>0.231 0.099 0.0715 1</ambient><diffuse>0.42 0.18 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p2"><pose>3 0 7.21208 0 0 0</pose><geometry><box><size>6.47121 22 0.12</size></box></geometry><material><ambient>0.231 0.099 0.0715 1</ambient><diffuse>0.42 0.18 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_21">
      <static>true</static>
      <pose>326 -132 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 2 0 0 0</pose><geometry><box><size>9 11 4</size></box></geometry><material><ambient>0.429 0.407 0.363 1</ambient><diffuse>0.78 0.74 0.66 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><collision name="p0_c"><pose>0 0 2 0 0 0</pose><geometry><box><size>9 11 4</size></box></geometry><surface><friction><ode/></friction><bounce/><contact/></surface></collision><visual name="p1"><pose>-2.25 0 4.90906 0 0 0</pose><geometry><box><size>4.85341 11 0.12</size></box></geometry><material><ambient>0.231 0.099 0.0715 1</ambient><diffuse>0.42 0.18 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p2"><pose>2.25 0 4.90906 0 0 0</pose><geometry><box><size>4.85341 11 0.12</size></box></geometry><material><ambient>0.231 0.099 0.0715 1</ambient><diffuse>0.42 0.18 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_22">

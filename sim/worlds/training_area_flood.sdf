      <static>true</static>
      <pose>657.387 591.408 0 0 0 1.36628</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>182.719 1.8 2.2</size></box></geometry><material><ambient>0.088 0.143 0.0715 1</ambient><diffuse>0.16 0.26 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_12">
      <static>true</static>
      <pose>163.518 427.551 0 0 0 1.66073</pose>
      <link name="l"><visual name="p0"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>197.223 1.8 2.2</size></box></geometry><material><ambient>0.088 0.143 0.0715 1</ambient><diffuse>0.16 0.26 0.13 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_13">
      <static>true</static>
      <pose>-489.497 625.443 0 0 0 1.92517</pose>

<?xml version="1.0" ?>
<!-- ================================================================
     LICENSED AIRFIELD - eastern England. Added 12 Oct 2026.

     WHY THIS WORLD EXISTS. Circuits. A runway with real markings gives
     a student a datum to fly a pattern against, a threshold to aim at,
     and a centreline to judge drift from - none of which an empty field
     provides. The approach lights off both ends give a visual glide
     reference, and the windsock is there to be read before every launch.

     It is also the right place to teach the airspace half of the
     syllabus: a licensed aerodrome is the one piece of ground where the
     question "who else is using this airspace" has an obvious answer.

     GENERIC, NOT A SURVEY. The runway markings follow the usual
     proportions - a dashed centreline and threshold bars - but the
     layout is not a copy of any real aerodrome and the coordinates are
     a flat spot in eastern England rather than a specific airfield.
     Nothing here should be used for a real site brief.

     WHERE IT IS. flat eastern England, 53.0500 N -0.2000 E,
     10 m above sea level. Flat, like every other area in this set, for
     the same reason: a PX4 VTOL behaves itself over level ground and
     the station enforces a 120 m ceiling, so relief inside the range
     limit would leave no airspace to fly in.

     The ground is a plane rather than a heightmap. Everything that
     makes this a place is scenery, added by tools/scenery_apply.py -
     see scenery.py for what is in it and why.

     NOT YET RUN. This world has not been loaded in Gazebo, and no
     aircraft has been flown in it.
     ================================================================ -->
<sdf version="1.9">
  <world name="training_area_airfield">

    <physics name="1ms" type="ignore">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- IGRF field at this world's own coordinates (53.0500N, -0.2000E,
         10 m) for 2026-10-12, in tesla ENU per the SDF spec:
         49549 nT, declination +1.07 deg, inclination +67.77 deg. Computed with ppigrf, the
         same way tools/fix_magnetic_field.py does the older worlds -
         NOT sdformat's placeholder, which would be several degrees out
         in inclination here and would keep PX4's EKF from settling on
         a heading. -->
    <magnetic_field>3.51e-07 1.874e-05 -4.587e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>53.05</latitude_deg>
      <longitude_deg>-0.2</longitude_deg>
      <elevation>10</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 0.97 0.90 1</diffuse>
      <specular>0.35 0.35 0.33 1</specular>
      <direction>-0.55 0.35 -0.62</direction>
    </light>

    <scene>
      <ambient>0.40 0.41 0.44 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
      <!-- A real skybox instead of one flat colour. gz-rendering8
           applies it to every sensor camera too, so the chase and
           nose feeds get it, not only the Gazebo window. Its
           sdformat sub-elements (time, clouds, humidity) are
           ignored by this renderer - it is on or off. -->
      <sky></sky>
    </scene>

    <!-- Flat ground with its top surface at Z=0.

         The collision is a very large BOX sunk 5 m, not a plane. PX4's own
         working default.sdf does exactly this (box 100000 x 100000 x 10 at
         pose 0 0 -5), and training_area's safety floor is a box too. A
         <plane> collision was tried here first and the aircraft fell straight
         through it - it appeared in the entity tree and in the model list
         reported by gz, but was nowhere to be seen, because it was still
         falling. Follow the
         working reference rather than the tidier-looking geometry.

         The visual stays a plane - widened from 8 km to 220 km square
         on 12 Oct 2026 by tools/far_ground_apply.py, so the 100 km
         instructor envelope is not flown over a void. A plane carries
         flat colour rather than a tiled texture, so the width costs
         nothing to render. The collision box was widened to match:
         it used to stop 50 km from home, half the envelope. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <pose>0 0 -5 0 0 0</pose>
          <geometry>
            <box>
              <size>220000 220000 10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>220000 220000</size>
            </plane>
          </geometry>
          <material>
            <!-- Mown airfield grass, which is kept shorter and paler than pasture. -->
            <ambient>0.28 0.38 0.20 1</ambient>
            <diffuse>0.35 0.47 0.26 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- A grid of markers every 100 m, so drift and distance are visible by
         eye rather than only on the instruments. Collision-free. -->
    <model name="distance_markers">
      <static>true</static>
      <link name="markers_link">
        <visual name="marker_n100"><pose>100 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_n200"><pose>200 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="marker_e100"><pose>0 100 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
        <visual name="marker_e200"><pose>0 200 0.5 0 0 0</pose>
          <geometry><box><size>0.4 2 1</size></box></geometry>
          <material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Wind: speed/direction are set at runtime by the instructor station over
         /world/NAME/wind (gz.msgs.Wind). Zero here so an untouched sim
         flies exactly as it did before wind was added. -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.03</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.03</stddev>
        </noise>
      </vertical>
    </plugin>
    <!-- Weather cell. Switched on at runtime by the instructor station over
         /weather/fog and /weather/rain (gz.msgs.ParticleEmitter);
         both start off, so an untouched sim looks exactly as it did before.
         Rendering only - this does not change how the aircraft flies.
         Added by tools/weather_apply.py. -->
    <plugin filename="gz-sim-particle-emitter-system"
            name="gz::sim::systems::ParticleEmitter">
    </plugin>
    <model name="weather_cell">
      <static>true</static>
      <!-- At this world's own ground height; emitter heights below are
           relative to it, so the cell sits over the ground in every world. -->
      <pose>0 0 0.3 0 0 0</pose>
      <link name="weather_link">
        <particle_emitter name="fog" type="box">
          <topic>/weather/fog</topic>
          <emitting>false</emitting>
          <!-- Tighter than the first attempt (was 240 x 240): the same
               particle budget spread over a quarter of the area is four times
               the obscuration. -->
          <pose>0 0 45 0 0 0</pose>
          <size>120 120 30</size>
          <!-- X and Y only; Z is ignored (see the rain emitter below). -->
          <particle_size>18 18 0</particle_size>
          <lifetime>25</lifetime>
          <min_velocity>0.1</min_velocity>
          <max_velocity>0.5</max_velocity>
          <scale_rate>0.5</scale_rate>
          <rate>160</rate>
          <particle_scatter_ratio>0.9</particle_scatter_ratio>
          <!-- The texture is what makes a particle a shape rather than a
               square. Without an albedo map Ogre draws a flat, hard-edged
               quad, which is what the first fog test looked like: pale
               rectangles stacked in the sky. -->
          <material>
            <diffuse>0.85 0.87 0.90</diffuse>
            <specular>0.85 0.87 0.90</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/particle_soft.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </particle_emitter>
        <!-- Pitched 90 degrees about Y so the emitter's local +X, which is the
             only direction Ogre2ParticleEmitter ever emits along, points at
             world -Z. Without this, rain falls sideways. -->
        <particle_emitter name="rain" type="box">
          <topic>/weather/rain</topic>
          <emitting>false</emitting>
          <!-- 45 m, not 95: the fall time sets the lifetime, the lifetime sets
               the rate ceiling (quota/lifetime), and the rate sets how much
               rain you can actually see. Halving the drop roughly trebles the
               rain. 45 m at 12-16 m/s is ~3.2 s, inside the 4 s lifetime. -->
          <pose>0 0 45 0 1.5707963 0</pose>
          <size>70 70 0</size>
          <!-- Only X and Y are read - Ogre2ParticleEmitter passes them to
               setDefaultDimensions(width, height) and ignores Z. 0.12 x 2.0 is
               a falling streak; the first attempt put the length in Z and so
               rendered 8 cm squares, which is why heavy rain looked like
               almost nothing. -->
          <particle_size>0.12 2.0 0</particle_size>
          <lifetime>4</lifetime>
          <min_velocity>12</min_velocity>
          <max_velocity>16</max_velocity>
          <scale_rate>0</scale_rate>
          <rate>450</rate>
          <particle_scatter_ratio>0.4</particle_scatter_ratio>
          <material>
            <diffuse>0.60 0.68 0.78</diffuse>
            <specular>0.60 0.68 0.78</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/particle_streak.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </particle_emitter>
      </link>
    </model>
      <!-- SCENERY: added by tools/scenery_apply.py.
         45 features, laid out deterministically from the world's
         own name - see scenery.py for what is here and why. The
         first 90 m around the launch point is left clear. Payload
         targets 1-3 are at 1: 035 deg / 260 m, 2: 160 deg / 430 m, 3: 285 deg / 700 m. -->
    <model name="scenery_0">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>900 23 0.1</size></box></geometry><material><ambient>0.143 0.143 0.1485 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p1"><pose>-410 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p2"><pose>-360 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p3"><pose>-310 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p4"><pose>-260 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p5"><pose>-210 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p6"><pose>-160 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p7"><pose>-110 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p8"><pose>-60 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p9"><pose>-10 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p10"><pose>40 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p11"><pose>90 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p12"><pose>140 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p13"><pose>190 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p14"><pose>240 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p15"><pose>290 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p16"><pose>340 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p17"><pose>390 0 0.12 0 0 0</pose><geometry><box><size>30 0.9 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p18"><pose>-438 -9 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p19"><pose>-438 -6.42857 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p20"><pose>-438 -3.85714 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p21"><pose>-438 -1.28571 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p22"><pose>-438 1.28571 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p23"><pose>-438 3.85714 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p24"><pose>-438 6.42857 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p25"><pose>-438 9 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p26"><pose>438 -9 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p27"><pose>438 -6.42857 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p28"><pose>438 -3.85714 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p29"><pose>438 -1.28571 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p30"><pose>438 1.28571 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p31"><pose>438 3.85714 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p32"><pose>438 6.42857 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual><visual name="p33"><pose>438 9 0.12 0 0 0</pose><geometry><box><size>18 1.1 0.04</size></box></geometry><material><ambient>0.506 0.506 0.495 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_1">
      <static>true</static>
      <pose>0 70 0 0 0 0</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>760 12 0.06</size></box></geometry><material><ambient>0.143 0.143 0.1485 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_2">
      <static>true</static>
      <pose>0 35 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>70 12 0.06</size></box></geometry><material><ambient>0.143 0.143 0.1485 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_3">
      <static>true</static>
      <pose>-300 35 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>70 12 0.06</size></box></geometry><material><ambient>0.143 0.143 0.1485 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_4">
      <static>true</static>
      <pose>300 35 0 0 0 1.5708</pose>
      <link name="l"><visual name="p0"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>70 12 0.06</size></box></geometry><material><ambient>0.143 0.143 0.1485 1</ambient><diffuse>0.26 0.26 0.27 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual></link>
    </model>
    <model name="scenery_5">

<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="training_area_blackrock">

    <physics name="1ms" type="ignore">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.87498</latitude_deg>
      <longitude_deg>-119.08493</longitude_deg>
      <elevation>1190.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ============================================================
         TERRAIN: real elevation data from Black Rock Desert playa, Nevada, USA
         (40.87498N/S, -119.08493E/W - see sign), sourced from Nextzen's
         Terrarium terrain tiles (the same open elevation-tile format
         and successor service to the one originally used for the
         Hoggar terrain), decoded directly from the raw tiles rather
         than via the Tangram Heightmapper viewer (whose in-browser
         WebGL preview was not rendering reliably when this was built
         - see 26 Aug 2026 decisions-log entry for detail).

         Ground area: 16km x 16km (wider than the 4km Hoggar area,
         for BVLOS range). Real elevation range within this exact
         tile: 1190.0m-1229.03m AMSL (39.03m of relief
         across the whole 16km square) - genuinely flat, natural
         ground, found by scanning the real elevation data for the
         flattest available window near this location rather than
         carving/flattening a clearing the way Hoggar's spawn point
         was. No <pos> offset is used inside the heightmap block
         (avoids the known gz-sim#1295 bug), and no additional model
         pose offset is needed either, since this location IS the
         flat area already - it sits centred on the world origin.

         The friction/bounce/contact <surface> block below is copied
         from the fix that resolved the Hoggar terrain's resting-drift
         bug (23 Aug 2026) and is included here from the start.

         NOT YET EMPIRICALLY VERIFIED: unlike Hoggar, this world has
         not yet been run in Gazebo and checked against
         vehicle_local_position_groundtruth for a genuine zero-drift
         resting state. Do that before relying on this for training.
         ============================================================ -->
    <model name="blackrock_terrain">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>file://media/blackrock_real_heightmap.png</uri>
              <size>16000 16000 39.03</size>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <use_terrain_paging>false</use_terrain_paging>
              <texture>
                <diffuse>file://media/grass_diffuse.png</diffuse>
                <normal>file://media/flat_normal.png</normal>
                <size>40</size>
              </texture>
              <uri>file://media/blackrock_real_heightmap.png</uri>
              <size>16000 16000 39.03</size>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         SAFETY FLOOR: same proven pattern as Hoggar's
         spawn_area_safety_floor - a plain, solid, collision-only
         (no visual) backup surface directly under the spawn point,
         in case the real terrain here also turns out to have a
         collision-vs-visual mismatch at this exact spot (gz-sim#1714
         class of bug). 900m x 900m, comfortably covering the local
         area around the chosen spawn point. Top surface at the same
         local Z height as SPAWN_POSE below.
         ============================================================ -->
    <model name="blackrock_spawn_area_safety_floor">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="safety_floor_link">
        <collision name="safety_floor_collision">
          <geometry>
            <box>
              <size>900 900 2</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Wind: speed/direction are set at runtime by the instructor station over
         /world/NAME/wind (gz.msgs.Wind). Zero here so an untouched sim
         flies exactly as it did before wind was added. -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.05</amplitude_percent>
            <period>60</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>5</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.03</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.03</stddev>
        </noise>
      </vertical>
    </plugin>
  </world>
</sdf>
